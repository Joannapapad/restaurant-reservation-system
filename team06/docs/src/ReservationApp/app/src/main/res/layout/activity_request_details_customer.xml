<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Request Date -->
    <TextView
        android:id="@+id/tv_request_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request Date: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tv_request_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request Time: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tv_scheduled_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scheduled Date: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <!-- Scheduled Time -->
    <TextView
        android:id="@+id/tv_scheduled_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scheduled Time: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <!-- Store ID -->
    <TextView
        android:id="@+id/tv_store_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Store ID: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <!-- Number of People -->
    <TextView
        android:id="@+id/tv_num_of_people"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Number of People: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <!-- Reservation Status -->
    <TextView
        android:id="@+id/tv_reservation_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reservation Status: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <!-- Comment -->
    <TextView
        android:id="@+id/tv_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comment: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btn_cancel_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel Request"
        android:textSize="18sp"
        android:textColor="#FF0000"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="16dp"/>

</LinearLayout>
