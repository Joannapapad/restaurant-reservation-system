<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/secondary_color"
    tools:context=".view.StoreOwner.AddStore.AddStoreActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">


        <EditText
            android:id="@+id/edit_text_store_name"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter store name"
            android:inputType="text"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <EditText
            android:id="@+id/edit_text_street"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter street"
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_text_store_name"
            android:layout_marginTop="15dp" />


        <EditText
            android:id="@+id/edit_text_street_number"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter street number"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_text_street"
            android:layout_marginTop="15dp" />

        <Spinner
            android:id="@+id/spinner_city"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_text_street_number"
            android:layout_marginTop="15dp" />


        <EditText
            android:id="@+id/edit_text_country"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter country"
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_city"
            android:layout_marginTop="15dp" />

        <EditText
            android:id="@+id/edit_text_postal_code"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter postal code"
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_text_country"
            android:layout_marginTop="15dp" />

        <Spinner
            android:id="@+id/spinner_store_type"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_text_postal_code"
            android:layout_marginTop="15dp" />


        <EditText
            android:id="@+id/edit_text_capacity"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter capacity"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_store_type"
            android:layout_marginTop="15dp" />


        <EditText
            android:id="@+id/edit_text_table_number"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter table number"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_text_capacity"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/button_save_store"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Save Store"
            android:background="@drawable/rounded_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_text_table_number"
            android:layout_marginTop="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
