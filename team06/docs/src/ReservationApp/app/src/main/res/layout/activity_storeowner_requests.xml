<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_color"
    tools:context=".view.StoreOwner.Requests.RequestsActivity">

    <!-- Your main content goes here -->


    <!-- Bottom Menu -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="134dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="127dp"
        android:text="Requests"
        android:textSize="36sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_stores"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="13dp"
        android:layout_marginTop="60dp"
        android:orientation="vertical"
        tools:listitem="@layout/store_item" />


    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="match_parent"
        android:layout_height="0.3in"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="@drawable/rounded_button"
        android:elevation="0.6in"
        android:layout_margin="0.15in">
        <!-- Search Button -->
        <ImageButton
            android:id="@+id/bottom_profile"
            android:layout_width="0dp"
            android:layout_height="0.3in"
            android:layout_weight="1"
            android:src="@drawable/baseline_person_24"
            android:contentDescription="Search"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/bottom_home"
            android:layout_width="0dp"
            android:layout_height="0.3in"
            android:layout_weight="1"
            android:src="@drawable/baseline_home_24"
            android:contentDescription="Settings"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Profile Button -->
        <ImageButton
            android:id="@+id/bottom_requests"
            android:layout_width="0dp"
            android:layout_height="0.3in"
            android:layout_weight="1"
            android:src="@drawable/baseline_check_24"
            android:contentDescription="Profile"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</RelativeLayout>
